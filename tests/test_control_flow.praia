use "testing"

testing.test("if/else", lam{ in
    let x = 10
    let result = ""
    if (x > 5) { result = "big" } else { result = "small" }
    testing.expectEqual(result, "big", nil)
})

testing.test("elif chain", lam{ in
    func classify(n) {
        if (n < 0) { return "negative" }
        elif (n == 0) { return "zero" }
        elif (n < 10) { return "small" }
        else { return "large" }
    }
    testing.expectEqual(classify(-5), "negative", nil)
    testing.expectEqual(classify(0), "zero", nil)
    testing.expectEqual(classify(3), "small", nil)
    testing.expectEqual(classify(100), "large", nil)
})

testing.test("while loop", lam{ in
    let i = 0
    let sum = 0
    while (i < 5) {
        sum = sum + i
        i = i + 1
    }
    testing.expectEqual(sum, 10, nil)
})

testing.test("for range loop", lam{ in
    let sum = 0
    for (i in 1 .. 11) {
        sum = sum + i
    }
    testing.expectEqual(sum, 55, nil)
})

testing.test("break", lam{ in
    let found = -1
    for (i in 0 .. 100) {
        if (i == 42) {
            found = i
            break
        }
    }
    testing.expectEqual(found, 42, nil)
})

testing.test("continue", lam{ in
    let evens = []
    for (i in 0 .. 10) {
        if (i % 2 != 0) { continue }
        evens.push(i)
    }
    testing.expectEqual(len(evens), 5, nil)
    testing.expectEqual(evens[0], 0, nil)
    testing.expectEqual(evens[4], 8, nil)
})

// A closure created in a loop body must keep the value it captured
// when break/continue leaves the body early, not read whatever the
// next iteration puts in the same stack slot.
func callAll(fs) { return map(fs, lam{ f in f() }) }

testing.test("break keeps captured locals", lam{ in
    let fs = []
    for (i in 0 .. 5) {
        let y = i * 2
        fs.push(lam{ in y })
        if (i == 2) { break }
    }
    testing.expectEqual(callAll(fs), [0, 2, 4], nil)
})

testing.test("continue keeps captured locals", lam{ in
    let fs = []
    let i = 0
    while (i < 4) {
        i = i + 1
        let v = i * 100
        fs.push(lam{ in v })
        if (i % 2 == 1) { continue }
    }
    testing.expectEqual(callAll(fs), [100, 200, 300, 400], nil)
})

testing.test("break in for-in keeps captured loop variable", lam{ in
    let fs = []
    for (x in [1, 2, 3]) {
        fs.push(lam{ in x })
        if (x == 2) { break }
    }
    testing.expectEqual(callAll(fs), [1, 2], nil)
})

testing.test("break/continue in match arms keep captured locals", lam{ in
    let fs = []
    for (i in 0 .. 5) {
        let y = i
        fs.push(lam{ in y })
        match (i) {
            2 {
                let z = i * 10
                fs.push(lam{ in z })
                break
            }
            _ {}
        }
    }
    testing.expectEqual(callAll(fs), [0, 1, 2, 20], nil)

    let gs = []
    for (i in 0 .. 4) {
        let y = i * 3
        gs.push(lam{ in y })
        match (i % 2) {
            0 { continue }
            _ {}
        }
    }
    testing.expectEqual(callAll(gs), [0, 3, 6, 9], nil)
})

testing.test("range loop gives each iteration its own variable", lam{ in
    let fs = []
    for (i in 0 .. 3) { fs.push(lam{ in i }) }
    testing.expectEqual(callAll(fs), [0, 1, 2], nil)

    let pairs = []
    for (i in 0 .. 2) {
        for (j in 0 .. 2) { pairs.push(lam{ in [i, j] }) }
    }
    testing.expectEqual(callAll(pairs), [[0, 0], [0, 1], [1, 0], [1, 1]], nil)
})

testing.test("range bounds are truncated toward zero", lam{ in
    let a = []
    for (i in 0 .. 2.5) { a.push(i) }
    testing.expectEqual(a, [0, 1], nil)

    let b = []
    for (i in 0.5 .. 3) { b.push(i) }
    testing.expectEqual(b, [0, 1, 2], nil)

    let c = []
    for (i in -2.7 .. 1.9) { c.push(i) }
    testing.expectEqual(c, [-2, -1, 0], nil)
})

testing.test("large integer range bounds keep full precision", lam{ in
    let a = []
    for (i in 9007199254740993 .. 9007199254740995) { a.push(i) }
    testing.expectEqual(a, [9007199254740993, 9007199254740994], nil)
})

testing.test("invalid range bounds throw", lam{ in
    let msg = nil
    try { for (i in 0 .. "x") {} } catch (e) { msg = str(e) }
    testing.expectContains(msg, "Range bounds must be numbers", nil)

    let inf = 1e308 * 10
    msg = nil
    try { for (i in 0 .. inf) {} } catch (e) { msg = str(e) }
    testing.expectContains(msg, "finite", nil)

    msg = nil
    try { for (i in 0 .. 1e30) {} } catch (e) { msg = str(e) }
    testing.expectContains(msg, "64-bit integer range", nil)
})

testing.test("both range bounds are evaluated before either is checked", lam{ in
    let log = []
    func lo() {
        log.push("lo")
        return "bad"
    }
    func hi() {
        log.push("hi")
        return 3
    }
    try { for (i in lo() .. hi()) {} } catch (e) {}
    testing.expectEqual(log, ["lo", "hi"], nil)
})

testing.test("assigning the range variable doesn't change iteration", lam{ in
    let seen = []
    for (i in 0 .. 5) {
        seen.push(i)
        i = i + 10
    }
    testing.expectEqual(seen, [0, 1, 2, 3, 4], nil)
})

testing.test("closure state survives break", lam{ in
    let fs = []
    for (i in 0 .. 3) {
        let n = 0
        fs.push(lam{ in
            n = n + 1
            return n
        })
        if (i == 1) { break }
    }
    testing.expectEqual([fs[0](), fs[0](), fs[1]()], [1, 2, 1], nil)
})

testing.test("truthiness", lam{ in
    // Only nil and false are falsy — everything else is truthy
    testing.expect(1, nil)
    testing.expect("hello", nil)
    testing.expect([1], nil)
    testing.expect(0, "0 is truthy")
    testing.expect("", "empty string is truthy")
    testing.expect([], "empty array is truthy")
    testing.expect(!nil, "nil is falsy")
    testing.expect(!false, "false is falsy")
})

testing.test("short-circuit or", lam{ in
    let x = nil || "default"
    testing.expectEqual(x, "default", nil)
    let y = "set" || "default"
    testing.expectEqual(y, "set", nil)
})

testing.done()
